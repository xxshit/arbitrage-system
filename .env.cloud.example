# 复制为 .env 后，必须替换所有密码与密钥。
DATABASE_URL=mysql+pymysql://arbi:change-before-deploying@db:3306/arbitrage_hub?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_COOKIE_SECURE=1
# Web Push is disabled until a matching P-256 key pair is configured outside Git.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/arbiscope_web_push_vapid.pem
WEB_PUSH_VAPID_SUBJECT=mailto:replace-with-an-operations-contact@example.com
